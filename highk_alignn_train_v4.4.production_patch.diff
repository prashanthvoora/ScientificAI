+def set_deterministic_seed(seed: int = 42) -> None:
+    """Set Python / NumPy / PyTorch seeds for reproducible runs."""
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
+    torch.backends.cudnn.deterministic = True
+    torch.backends.cudnn.benchmark = False
+    os.environ.setdefault("PYTHONHASHSEED", str(seed))
+
+
+def validate_target_columns(df: pd.DataFrame, target_cols: List[str], label: str) -> None:
+    """Fail fast on missing or non-finite target columns in production runs."""
+    missing = [c for c in target_cols if c not in df.columns]
+    if missing:
+        raise ValueError(f"{label}: missing required columns -> {missing}")
+
+    for col in target_cols:
+        s = pd.to_numeric(df[col], errors="coerce")
+        if s.dropna().empty:
+            raise ValueError(f"{label}: column '{col}' has no valid numeric values")
+        if not np.isfinite(s.dropna().to_numpy()).all():
+            raise ValueError(f"{label}: column '{col}' contains non-finite values")
+
+
 def is_rank0() -> bool:
